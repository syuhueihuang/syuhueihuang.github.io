---
import { siteConfig } from "../config";
---

<section id="skills" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold text-gray-900"
        >
          Skills
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="flex flex-wrap gap-3">
          {
            siteConfig.skills.map((skill) => (
              <span class="px-4 py-2 bg-gray-100 text-gray-800 rounded-full text-base md:text-lg font-medium hover:bg-gray-200 transition-colors duration-200 border border-gray-200">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
