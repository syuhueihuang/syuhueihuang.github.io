---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6 sm:space-y-8">
              {siteConfig.experience.map((exp, index) => (
                <details class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5">
                  <summary class="list-none cursor-pointer">
                    <div
                      class="absolute inset-y-0 left-0 w-1.5"
                      style={`background: linear-gradient(180deg, ${siteConfig.accentColor}, #60a5fa)`}
                    />

                    <div class="p-5 sm:p-6 md:p-8 pl-6 sm:pl-7 md:pl-8">
                      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-6 mb-5">
                        <div class="space-y-1">
                          <p
                            class="text-xs sm:text-sm font-semibold uppercase tracking-[0.16em]"
                            style={`color: ${siteConfig.accentColor}`}
                          >
                            Experience {index + 1}
                          </p>
                          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 leading-tight">
                            {exp.title}
                          </h3>
                          <p class="text-base sm:text-lg font-medium text-gray-700">
                            {exp.company}
                          </p>
                        </div>
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs sm:text-sm font-medium text-gray-600 whitespace-nowrap">
                          {exp.dateRange}
                        </span>
                      </div>

                      <div class="mb-3">
                        <p class="text-xs sm:text-sm uppercase tracking-[0.14em] text-gray-500">
                          Key Contributions
                        </p>
                      </div>

                      <ul class="space-y-3">
                        {exp.bullets.slice(0, 1).map((bullet) => (
                          <li class="flex items-start gap-3">
                            <span
                              class="mt-2 inline-block h-2.5 w-2.5 flex-shrink-0 rounded-full"
                              style={`background-color: ${siteConfig.accentColor}`}
                            />
                            <span class="text-sm sm:text-base md:text-lg leading-7 text-gray-600" set:html={bullet}>
                              {/* {bullet} */}
                            </span>
                          </li>
                        ))}
                      </ul>

                      {exp.bullets.length > 1 && (
                        <div class="mt-4">
                          <div class="flex items-start gap-3 group-open:hidden">
                            <span
                              class="mt-2 inline-block h-2.5 w-2.5 flex-shrink-0 rounded-full blur-[1px] opacity-60"
                              style={`background-color: ${siteConfig.accentColor}`}
                            />
                            <span class="text-sm sm:text-base md:text-lg leading-7 text-gray-600 blur-[1.5px] opacity-60 line-clamp-1 overflow-hidden">
                              {exp.bullets[1]}
                            </span>
                          </div>
                          <div class="hidden group-open:block">
                            <ul class="space-y-3">
                              {exp.bullets.slice(1).map((bullet) => (
                                <li class="flex items-start gap-3">
                                  <span
                                    class="mt-2 inline-block h-2.5 w-2.5 flex-shrink-0 rounded-full"
                                    style={`background-color: ${siteConfig.accentColor}`}
                                  />
                                  <span class="text-sm sm:text-base md:text-lg leading-7 text-gray-600" set:html={bullet}>
                                    {/* {bullet} */}
                                  </span>
                                </li>
                              ))}
                            </ul>
                            <p class="mt-3 text-xs sm:text-sm text-gray-400">
                              Click to hide
                            </p>
                          </div>
                        </div>
                      )}
                    </div>
                  </summary>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
