---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <p class="mb-3 text-xs sm:text-sm text-gray-500 uppercase tracking-[0.14em]">
              Scroll to see more projects
            </p>
            <div class="grid grid-cols-1 gap-5 sm:gap-6 max-h-[42rem] overflow-y-auto pr-2 projects-stack-scroll">
              {siteConfig.projects.map((project, index) => (
                <details class="group h-full overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5">
                  <summary class="list-none cursor-pointer h-full">
                    <div class="relative h-full p-5 sm:p-6 md:p-7">
                      <div
                        class="absolute top-0 left-0 right-0 h-1.5"
                        style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, #60a5fa)`}
                      />

                      <div class="flex items-start justify-between gap-4 mb-4">
                        <span
                          class="text-sm font-mono tracking-wider"
                          style={{ color: siteConfig.accentColor }}
                        >
                          0{index + 1}
                        </span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="text-gray-400 transition-transform duration-200 group-open:rotate-180"
                        >
                          <path d="M6 9l6 6l6 -6"></path>
                        </svg>
                      </div>

                      <h3 class="text-xl sm:text-2xl font-bold text-gray-900 leading-tight">
                        {project.name}
                      </h3>

                      {project.skills && project.skills.length > 0 && (
                        <p class="text-xs sm:text-sm text-gray-500 mt-2 uppercase tracking-[0.12em]">
                          {project.skills.slice(0, 3).join(" • ")}
                        </p>
                      )}

                      <div class="mt-4 flex items-center justify-between gap-4">
                        <span class="text-xs sm:text-sm text-gray-400 group-open:hidden">
                          Click to view detail
                        </span>
                        <span class="hidden text-xs sm:text-sm text-gray-400 group-open:inline">
                          Click to hide
                        </span>
                      </div>

                      <div class="mt-4 hidden group-open:block border-t border-gray-100 pt-4">
                        <p class="text-sm sm:text-base text-gray-600 leading-7" set:html={project.description}>
                          {/* {project.description} */}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-4">
                            {project.skills.map((skill) => (
                              <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-100 text-gray-700 border border-gray-200 rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300">
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}

                        {project.link && (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex mt-4 items-center gap-2 rounded-full bg-gray-900 px-4 py-2 text-xs sm:text-sm font-medium text-white transition-all duration-300 hover:bg-gray-700"
                          >
                            View Project
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 17L17 7M17 7H7M17 7V17"
                              />
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </summary>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .projects-stack-scroll {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  .projects-stack-scroll::-webkit-scrollbar {
    width: 8px;
  }

  .projects-stack-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .projects-stack-scroll::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 9999px;
  }
</style>
